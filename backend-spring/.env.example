# Server
SERVER_PORT=5000

# Database - same MariaDB instance/schema as backend/config/db.js
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medixoffice
DB_USER=root
DB_PASSWORD=root

# JWT - HS256 requires at least 32 characters. Generate your own; this is not
# a usable default and the app will fail fast at startup if it's blank/short.
JWT_SECRET=replace_with_a_random_32plus_character_secret
JWT_EXPIRATION_MS=2592000000

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Used in outgoing emails (welcome, reminders, reset links)
APP_URL=http://localhost:5173

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# PayPal (called via RestClient, no SDK)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Medical record file uploads
MEDICAL_FILES_DIR=./medicalFiles
